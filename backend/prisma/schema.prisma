generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                  Int                 @id @default(autoincrement())
  name                String
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  subdomain           String              @unique @default("school1")
  address             String?
  defaultAcademicYear String?
  defaultClass        String?
  defaultSection      String?
  email               String?
  logoUrl             String?
  phone               String?
  website             String?
  academicYears       AcademicYear[]
  classes             Class[]
  customFields        CustomField[]
  departments         Department[]
  exams               Exam[]
  examMarks           ExamMark[]
  feeCategories       FeeCategory[]
  feeCollections      FeeCollection[]
  feeStructures       FeeStructure[]
  holidays            Holiday[]
  masterData          MasterData[]
  notifications       Notification[]
  notificationReads   NotificationRead[]
  periodSlots         PeriodSlot[]
  resultPublications  ResultPublication[]
  sections            Section[]
  staff               Staff[]
  staffAttendances    StaffAttendance[]
  students            Student[]
  studentAttendances  StudentAttendance[]
  subjects            Subject[]
  timetables          Timetable[]
  users               User[]
  aiConversations     AIConversation[]
  aiMessages          AIMessage[]
}

model User {
  id              Int              @id @default(autoincrement())
  name            String
  email           String
  password        String
  tenantId        Int
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  isDeleted       Boolean          @default(false)
  identity        Identity         @default(admin)
  staffId         Int?             @unique
  avatarUrl       String?
  parentId        Int?             @unique
  phone           String?
  parent          StudentParent?   @relation(fields: [parentId], references: [id])
  staff           Staff?           @relation(fields: [staffId], references: [id])
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  aiConversations AIConversation[]
  aiMessages      AIMessage[]

  @@unique([email, tenantId])
  @@index([tenantId])
}

model AcademicYear {
  id                 Int                 @id @default(autoincrement())
  name               String
  startDate          DateTime
  endDate            DateTime
  isActive           Boolean             @default(false)
  tenantId           Int
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  isDeleted          Boolean             @default(false)
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  exams              Exam[]
  feeCollections     FeeCollection[]
  feeStructures      FeeStructure[]
  holidays           Holiday[]
  resultPublications ResultPublication[]
  staffAttendances   StaffAttendance[]
  studentAttendances StudentAttendance[]
  timetables         Timetable[]

  @@unique([name, tenantId])
  @@unique([startDate, endDate, tenantId])
  @@index([name, tenantId])
  @@index([tenantId])
}

model Department {
  id        Int      @id @default(autoincrement())
  name      String
  tenantId  Int
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  classes   Class[]
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff     Staff[]

  @@unique([name, tenantId])
  @@index([tenantId])
}

model Class {
  id                 Int                 @id @default(autoincrement())
  name               String
  tenantId           Int
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  departmentId       Int?
  isDeleted          Boolean             @default(false)
  department         Department?         @relation(fields: [departmentId], references: [id])
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  exams              Exam[]
  feeStructures      FeeStructure[]
  resultPublications ResultPublication[]
  sections           Section[]
  students           Student[]
  studentAttendances StudentAttendance[]
  timetables         Timetable[]

  @@unique([name, tenantId])
  @@index([tenantId])
}

model Section {
  id                 Int                 @id @default(autoincrement())
  name               String
  classId            Int
  tenantId           Int
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  isDeleted          Boolean             @default(false)
  class              Class               @relation(fields: [classId], references: [id], onDelete: Cascade)
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  students           Student[]
  studentAttendances StudentAttendance[]
  timetables         Timetable[]

  @@unique([name, classId, tenantId])
  @@index([tenantId])
}

model Subject {
  id         Int            @id @default(autoincrement())
  name       String
  code       String
  tenantId   Int
  isDeleted  Boolean        @default(false)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  examMarks  ExamMark[]
  staff      StaffSubject[]
  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  timetables Timetable[]

  @@unique([code, tenantId])
  @@index([tenantId])
}

model Staff {
  id                       Int                 @id @default(autoincrement())
  employeeId               String
  name                     String
  email                    String
  phone                    String?
  dateOfJoining            DateTime?
  salary                   Decimal?            @db.Decimal(10, 2)
  photoUrl                 String?
  departmentId             Int?
  tenantId                 Int
  isDeleted                Boolean             @default(false)
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  role                     StaffRole?
  gender                   Gender?
  aadharNo                 String?
  bloodGroup               String?
  busUser                  Boolean             @default(false)
  caste                    String?
  cbseTid                  String?
  ctetExamQualified        String?
  dateOfBirth              DateTime?
  emergencyContactNo       String?
  emergencyContactPerson   String?
  employeeLedger           String?
  employeePresentDuty      String?
  employeeUniqueId         String?
  experience               String?
  fatherName               String?
  fileNo                   String?
  highQualification        String?
  identificationMark       String?
  isReviewer               Boolean             @default(false)
  leaveCategory            String?
  maritalStatus            String?
  mobileNo                 String?
  motherName               String?
  motherTongue             String?
  nationality              String?
  noticePeriod             Boolean             @default(false)
  officialEmail            String?
  panNo                    String?
  placeOfBirth             String?
  priorityNo               String?
  qualificationForPrinting String?
  relationWithEmployee     String?
  religion                 String?
  reportPerson             String?
  rfidNo                   String?
  signatureUrl             String?
  socialCategory           String?
  staffCategory            String?
  staffDirectory           String?
  title                    String?
  uanNo                    String?
  examMarksEntered         ExamMark[]
  feeCollections           FeeCollection[]
  resultPublications       ResultPublication[]
  department               Department?         @relation(fields: [departmentId], references: [id])
  tenant                   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  address                  StaffAddress?
  staffAttendances         StaffAttendance[]
  children                 StaffChild[]
  otherDetails             StaffOtherDetails?
  spouse                   StaffSpouse?
  subjects                 StaffSubject[]
  studentAttendancesMarked StudentAttendance[]
  timetables               Timetable[]
  user                     User?

  @@unique([employeeId, tenantId])
  @@unique([email, tenantId])
  @@index([tenantId])
}

model StaffSubject {
  id        Int      @id @default(autoincrement())
  staffId   Int
  subjectId Int
  tenantId  Int
  createdAt DateTime @default(now())
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([staffId, subjectId])
  @@index([tenantId])
}

model StaffAddress {
  id                   Int      @id @default(autoincrement())
  staffId              Int      @unique
  tenantId             Int
  presentAddress       String?
  presentCity          String?
  presentState         String?
  presentCountry       String?
  presentPinCode       String?
  presentTelephoneNo   String?
  permanentAddress     String?
  permanentCity        String?
  permanentState       String?
  permanentCountry     String?
  permanentPinCode     String?
  permanentTelephoneNo String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  staff                Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model StaffOtherDetails {
  id                  Int       @id @default(autoincrement())
  staffId             Int       @unique
  tenantId            Int
  dateOfAppointment   DateTime?
  probationUpto       DateTime?
  dateOfConfirmation  DateTime?
  designation         String?
  fromDate            DateTime?
  natureOfAppointment String?
  passportNo          String?
  passportIssuePlace  String?
  passportIssueDate   DateTime?
  passportExpireDate  DateTime?
  visaNo              String?
  visaIssuePlace      String?
  visaIssueDate       DateTime?
  visaExpiryDate      DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  staff               Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model StaffSpouse {
  id              Int       @id @default(autoincrement())
  staffId         Int       @unique
  tenantId        Int
  name            String?
  dateOfBirth     DateTime?
  mobileNo        String?
  marriageDate    DateTime?
  qualification   String?
  employerDetails String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  staff           Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model StaffChild {
  id          Int       @id @default(autoincrement())
  staffId     Int
  tenantId    Int
  name        String?
  dateOfBirth DateTime?
  gender      Gender?
  schoolName  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  staff       Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@index([tenantId])
}

model Student {
  id                  Int                 @id @default(autoincrement())
  admissionNo         String
  feeNo               String?
  siblingAdmNo        String?
  studentName         String
  childLivingWith     String?
  photoUrl            String?
  signatureUrl        String?
  fatherTitle         String?
  fatherName          String?
  motherTitle         String?
  motherName          String?
  classId             Int
  sectionId           Int?
  stream              String?
  feeGroup            String?
  feePaymentStartFrom String?
  dateOfBirth         DateTime?
  dateOfAdmission     DateTime?
  dateOfJoin          DateTime?
  rollNo              String?
  gender              Gender?
  admissionType       AdmissionType       @default(new)
  classAdmitted       String?
  emergencyPhoneNo    String?
  house               String?
  boardingCategory    String?
  board               String?
  medium              String?
  boardRegistrationNo String?
  studentEmail        String?
  countryCode         String?
  communicationMobile String?
  communicationEmail  String?
  aadharNo            String?
  remark              String?
  feeRemark           String?
  uniqueNo            String?
  grNo                String?
  rfidNo              String?
  eNach               String?
  bankName            String?
  accountNo           String?
  ifsc                String?
  virtualAccountNo    String?
  apaarId             String?
  srnNo               String?
  tenantId            Int
  isDeleted           Boolean             @default(false)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  bloodGroup          String?
  category            String?
  maritalStatus       String?
  motherTongue        String?
  nationality         String?
  religion            String?
  customFieldValues   CustomFieldValue[]
  examMarks           ExamMark[]
  feeCollections      FeeCollection[]
  class               Class               @relation(fields: [classId], references: [id])
  section             Section?            @relation(fields: [sectionId], references: [id])
  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentAttendances  StudentAttendance[]
  parents             StudentParent[]

  @@unique([admissionNo, tenantId])
  @@index([tenantId])
}

model StudentParent {
  id                  Int      @id @default(autoincrement())
  studentId           Int
  tenantId            Int
  relation            String
  title               String?
  name                String
  photoUrl            String?
  signatureUrl        String?
  qualification       String?
  occupation          String?
  designation         String?
  organizationName    String?
  organizationAddress String?
  email               String?
  aadharNo            String?
  mobile              String?
  telephoneNo         String?
  nationality         String?
  annualIncome        Decimal? @db.Decimal(12, 2)
  annualIncomeSlab    String?
  city                String?
  state               String?
  country             String?
  pinCode             String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  student             Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  user                User?

  @@index([studentId])
  @@index([tenantId])
}

model MasterData {
  id        Int      @id @default(autoincrement())
  category  String
  value     String
  isActive  Boolean  @default(true)
  tenantId  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([category, value, tenantId])
  @@index([tenantId, category])
}

model CustomField {
  id          Int                 @id @default(autoincrement())
  formName    String
  name        String
  displayName String
  control     String
  dataType    String              @default("text")
  priority    Int                 @default(1)
  maxLength   Int?
  isActive    Boolean             @default(true)
  tenantId    Int
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  options     CustomFieldOption[]
  values      CustomFieldValue[]

  @@unique([formName, name, tenantId])
  @@index([tenantId])
}

model CustomFieldValue {
  id            Int         @id @default(autoincrement())
  customFieldId Int
  studentId     Int
  value         String
  tenantId      Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  customField   CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)
  student       Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([customFieldId, studentId])
  @@index([tenantId])
}

model CustomFieldOption {
  id            Int         @id @default(autoincrement())
  customFieldId Int
  label         String
  value         String
  priority      Int         @default(1)
  isActive      Boolean     @default(true)
  tenantId      Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  customField   CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([customFieldId])
}

model PeriodSlot {
  id         Int         @id @default(autoincrement())
  tenantId   Int
  slotNo     Int
  label      String
  slotType   String
  startTime  String
  endTime    String
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  timetables Timetable[]

  @@unique([tenantId, slotNo])
  @@index([tenantId])
}

model Timetable {
  id             Int          @id @default(autoincrement())
  tenantId       Int
  academicYearId Int
  classId        Int
  sectionId      Int?
  subjectId      Int
  staffId        Int
  periodSlotId   Int
  dayOfWeek      Int
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  class          Class        @relation(fields: [classId], references: [id])
  periodSlot     PeriodSlot   @relation(fields: [periodSlotId], references: [id])
  section        Section?     @relation(fields: [sectionId], references: [id])
  staff          Staff        @relation(fields: [staffId], references: [id])
  subject        Subject      @relation(fields: [subjectId], references: [id])
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, academicYearId, staffId, dayOfWeek, periodSlotId])
  @@unique([tenantId, academicYearId, classId, sectionId, dayOfWeek, periodSlotId])
  @@index([tenantId])
}

model StudentAttendance {
  id             Int              @id @default(autoincrement())
  tenantId       Int
  academicYearId Int
  studentId      Int
  classId        Int
  sectionId      Int?
  date           DateTime         @db.Date
  status         AttendanceStatus @default(present)
  remark         String?
  markedById     Int
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id])
  class          Class            @relation(fields: [classId], references: [id])
  markedBy       Staff            @relation(fields: [markedById], references: [id])
  section        Section?         @relation(fields: [sectionId], references: [id])
  student        Student          @relation(fields: [studentId], references: [id])
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, studentId, date])
  @@index([tenantId, classId, date])
  @@index([tenantId, studentId])
}

model StaffAttendance {
  id             Int              @id @default(autoincrement())
  tenantId       Int
  academicYearId Int
  staffId        Int
  date           DateTime         @db.Date
  status         AttendanceStatus @default(present)
  inTime         String?
  outTime        String?
  remark         String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id])
  staff          Staff            @relation(fields: [staffId], references: [id])
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, staffId, date])
  @@index([tenantId, staffId])
  @@index([tenantId, date])
}

model FeeCategory {
  id            Int            @id @default(autoincrement())
  tenantId      Int
  name          String
  description   String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feeStructures FeeStructure[]

  @@unique([name, tenantId])
  @@index([tenantId])
}

model FeeStructure {
  id              Int             @id @default(autoincrement())
  tenantId        Int
  academicYearId  Int
  classId         Int
  feeCategoryId   Int
  stream          String?
  studentCategory String?
  amount          Decimal         @db.Decimal(10, 2)
  frequency       String          @default("annual")
  dueDay          Int?
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  collections     FeeCollection[]
  academicYear    AcademicYear    @relation(fields: [academicYearId], references: [id])
  class           Class           @relation(fields: [classId], references: [id])
  feeCategory     FeeCategory     @relation(fields: [feeCategoryId], references: [id])
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, academicYearId, classId])
}

model FeeCollection {
  id             Int          @id @default(autoincrement())
  tenantId       Int
  receiptNo      String
  studentId      Int
  feeStructureId Int
  academicYearId Int
  amount         Decimal      @db.Decimal(10, 2)
  discount       Decimal      @default(0) @db.Decimal(10, 2)
  fine           Decimal      @default(0) @db.Decimal(10, 2)
  netAmount      Decimal      @db.Decimal(10, 2)
  paymentMode    String
  paymentDate    DateTime     @db.Date
  chequeNo       String?
  bankName       String?
  transactionId  String?
  remark         String?
  collectedById  Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  collectedBy    Staff        @relation(fields: [collectedById], references: [id])
  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id])
  student        Student      @relation(fields: [studentId], references: [id])
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([receiptNo, tenantId])
  @@index([tenantId, studentId])
  @@index([tenantId, academicYearId])
}

model Exam {
  id                 Int                 @id @default(autoincrement())
  tenantId           Int
  academicYearId     Int
  name               String
  examType           ExamType
  classId            Int
  startDate          DateTime            @db.Date
  endDate            DateTime            @db.Date
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  academicYear       AcademicYear        @relation(fields: [academicYearId], references: [id])
  class              Class               @relation(fields: [classId], references: [id])
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  marks              ExamMark[]
  resultPublications ResultPublication[]

  @@index([tenantId, academicYearId])
}

model ExamMark {
  id            Int      @id @default(autoincrement())
  tenantId      Int
  examId        Int
  studentId     Int
  subjectId     Int
  maxMarks      Decimal  @db.Decimal(6, 2)
  marksObtained Decimal? @db.Decimal(6, 2)
  isAbsent      Boolean  @default(false)
  grade         String?
  gradePoint    Decimal? @db.Decimal(4, 2)
  remark        String?
  enteredById   Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  enteredBy     Staff    @relation(fields: [enteredById], references: [id])
  exam          Exam     @relation(fields: [examId], references: [id])
  student       Student  @relation(fields: [studentId], references: [id])
  subject       Subject  @relation(fields: [subjectId], references: [id])
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId, subjectId])
  @@index([tenantId, examId])
  @@index([tenantId, studentId])
}

model Holiday {
  id             Int          @id @default(autoincrement())
  tenantId       Int
  academicYearId Int
  name           String
  date           DateTime     @db.Date
  holidayType    String       @default("public")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date])
  @@index([tenantId, academicYearId])
}

model Assignment {
  id                   Int                    @id @default(autoincrement())
  tenantId             Int
  title                String
  description          String?
  classId              Int
  sectionId            Int?
  subjectId            Int
  teacherId            Int
  dueDate              DateTime
  attachmentUrl        String?
  maxMarks             Int?                   @default(100)
  isActive             Boolean                @default(true)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @default(now()) @updatedAt
  AssignmentSubmission AssignmentSubmission[]

  @@index([tenantId, classId, sectionId, subjectId])
  @@index([tenantId, teacherId])
}

model AssignmentSubmission {
  id            Int                      @id @default(autoincrement())
  tenantId      Int
  assignmentId  Int
  studentId     Int
  content       String?
  attachmentUrl String?
  status        HomeworkSubmissionStatus @default(submitted)
  submittedAt   DateTime                 @default(now())
  grade         Int?
  feedback      String?
  gradedById    Int?
  gradedAt      DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @default(now()) @updatedAt
  Assignment    Assignment               @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, assignmentId, studentId])
  @@index([tenantId, studentId])
}

model Notification {
  id               Int                  @id @default(autoincrement())
  tenantId         Int
  title            String
  message          String
  type             String               @default("general")
  priority         NotificationPriority @default(normal)
  audience         NotificationAudience
  classId          Int?
  sectionId        Int?
  userId           Int?
  createdById      Int?
  isActive         Boolean              @default(true)
  expiresAt        DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  Tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  NotificationRead NotificationRead[]

  @@index([tenantId, audience, isActive])
  @@index([tenantId, classId])
  @@index([tenantId, createdAt])
  @@index([tenantId, userId])
}

model NotificationRead {
  id             Int          @id @default(autoincrement())
  tenantId       Int
  notificationId Int
  userId         Int
  readAt         DateTime     @default(now())
  Notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  Tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([tenantId, userId])
}

model ResultPublication {
  id             Int          @id @default(autoincrement())
  tenantId       Int
  academicYearId Int
  classId        Int
  examId         Int?
  isPublished    Boolean      @default(false)
  publishedById  Int?
  publishedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  AcademicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  Class          Class        @relation(fields: [classId], references: [id])
  Exam           Exam?        @relation(fields: [examId], references: [id])
  Staff          Staff?       @relation(fields: [publishedById], references: [id])
  Tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([academicYearId, classId, examId])
  @@index([tenantId, academicYearId])
}

// =========================================================
// AI TEACHER CO-PILOT CHAT HISTORY
// =========================================================

model AIConversation {
  id        Int      @id @default(autoincrement())
  tenantId  Int
  userId    Int
  title     String   @default("New Chat")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AIMessage[]

  @@index([tenantId, userId])
  @@index([tenantId, updatedAt])
}

model AIMessage {
  id             Int      @id @default(autoincrement())
  tenantId       Int
  userId         Int
  conversationId Int
  role           String
  content        String
  imageUrl       String?
  createdAt      DateTime @default(now())

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([conversationId, createdAt])
}

