generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Identity {
  admin
  staff
  student
  parent
  principal
  management
}

enum StaffRole {
  teacher
  accountant
  librarian
  clerk
  receptionist
  nurse
  counselor
  coordinator
  lab_assistant
  peon
  driver
  security
  other
}

enum Gender {
  male
  female
  other
}

enum AdmissionType {
  new
  transfer
  readmission
}

enum AttendanceStatus {
  present
  absent
  late
  half_day
  holiday
  leave
}

enum ExamType {
  unit_test_1
  unit_test_2
  half_yearly
  annual
  pre_board
  practical
  internal_assessment
}

// ─────────────────────────────────────────────
// TENANT
// ─────────────────────────────────────────────
model Tenant {
  id                  Int      @id @default(autoincrement())
  name                String
  subdomain           String   @unique @default("school1")
  address             String?
  phone               String?
  email               String?
  website             String?
  logoUrl             String?
  defaultAcademicYear String?
  defaultClass        String?
  defaultSection      String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  users              User[]
  academicYears      AcademicYear[]
  classes            Class[]
  sections           Section[]
  departments        Department[]
  subjects           Subject[]
  staff              Staff[]
  students           Student[]
  masterData         MasterData[]
  customFields       CustomField[]
  periodSlots        PeriodSlot[]
  timetables         Timetable[]
  studentAttendances StudentAttendance[]
  staffAttendances   StaffAttendance[]
  feeCategories      FeeCategory[]
  feeStructures      FeeStructure[]
  feeCollections     FeeCollection[]
  exams              Exam[]
  examMarks          ExamMark[]
  holidays           Holiday[]
  notifications      Notification[]
  notificationReads  NotificationRead[]
  resultPublications ResultPublication[]
}

// ─────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────
model User {
  id        Int            @id @default(autoincrement())
  name      String
  email     String
  password  String
  phone     String?
  avatarUrl String?
  identity  Identity       @default(admin)
  tenantId  Int
  staffId   Int?           @unique
  parentId  Int?           @unique
  isDeleted Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff     Staff?         @relation(fields: [staffId], references: [id])
  parent    StudentParent? @relation(fields: [parentId], references: [id])

  @@unique([email, tenantId])
  @@index([tenantId])
}

// ─────────────────────────────────────────────
// ACADEMIC YEAR
// ─────────────────────────────────────────────
model AcademicYear {
  id                 Int                 @id @default(autoincrement())
  name               String
  startDate          DateTime
  endDate            DateTime
  isActive           Boolean             @default(false)
  tenantId           Int
  isDeleted          Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  timetables         Timetable[]
  studentAttendances StudentAttendance[]
  staffAttendances   StaffAttendance[]
  feeStructures      FeeStructure[]
  feeCollections     FeeCollection[]
  exams              Exam[]
  holidays           Holiday[]
  resultPublications ResultPublication[]

  @@unique([name, tenantId])
  @@index([tenantId])
}

// ─────────────────────────────────────────────
// DEPARTMENT
// ─────────────────────────────────────────────
model Department {
  id        Int      @id @default(autoincrement())
  name      String
  tenantId  Int
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classes   Class[]
  staff     Staff[]

  @@unique([name, tenantId])
  @@index([tenantId])
}

// ─────────────────────────────────────────────
// CLASS
// ─────────────────────────────────────────────
model Class {
  id                 Int                 @id @default(autoincrement())
  name               String
  departmentId       Int?
  tenantId           Int
  isDeleted          Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  department         Department?         @relation(fields: [departmentId], references: [id])
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sections           Section[]
  students           Student[]
  timetables         Timetable[]
  studentAttendances StudentAttendance[]
  feeStructures      FeeStructure[]
  exams              Exam[]
  resultPublications ResultPublication[]

  @@unique([name, tenantId])
  @@index([tenantId])
}

// ─────────────────────────────────────────────
// SECTION
// ─────────────────────────────────────────────
model Section {
  id                 Int                 @id @default(autoincrement())
  name               String
  classId            Int
  tenantId           Int
  isDeleted          Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  class              Class               @relation(fields: [classId], references: [id], onDelete: Cascade)
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  students           Student[]
  timetables         Timetable[]
  studentAttendances StudentAttendance[]

  @@unique([name, classId, tenantId])
  @@index([tenantId])
}

// ─────────────────────────────────────────────
// SUBJECT
// ─────────────────────────────────────────────
model Subject {
  id         Int            @id @default(autoincrement())
  name       String
  code       String
  tenantId   Int
  isDeleted  Boolean        @default(false)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff      StaffSubject[]
  timetables Timetable[]
  examMarks  ExamMark[]

  @@unique([code, tenantId])
  @@index([tenantId])
}

// ─────────────────────────────────────────────
// STAFF
// ─────────────────────────────────────────────
model Staff {
  id                       Int                 @id @default(autoincrement())
  employeeId               String
  fileNo                   String?
  title                    String?
  name                     String
  email                    String
  officialEmail            String?
  phone                    String?
  mobileNo                 String?
  photoUrl                 String?
  signatureUrl             String?
  gender                   Gender?
  dateOfBirth              DateTime?
  fatherName               String?
  motherName               String?
  nationality              String?
  motherTongue             String?
  religion                 String?
  maritalStatus            String?
  bloodGroup               String?
  caste                    String?
  placeOfBirth             String?
  identificationMark       String?
  emergencyContactPerson   String?
  relationWithEmployee     String?
  emergencyContactNo       String?
  aadharNo                 String?
  uanNo                    String?
  panNo                    String?
  rfidNo                   String?
  cbseTid                  String?
  priorityNo               String?
  employeeUniqueId         String?
  role                     StaffRole?
  staffCategory            String?
  socialCategory           String?
  highQualification        String?
  staffDirectory           String?
  qualificationForPrinting String?
  busUser                  Boolean             @default(false)
  ctetExamQualified        String?
  employeePresentDuty      String?
  noticePeriod             Boolean             @default(false)
  isReviewer               Boolean             @default(false)
  dateOfJoining            DateTime?
  salary                   Decimal?            @db.Decimal(10, 2)
  departmentId             Int?
  reportPerson             String?
  leaveCategory            String?
  experience               String?
  employeeLedger           String?
  tenantId                 Int
  isDeleted                Boolean             @default(false)
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  tenant                   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department               Department?         @relation(fields: [departmentId], references: [id])
  subjects                 StaffSubject[]
  address                  StaffAddress?
  otherDetails             StaffOtherDetails?
  spouse                   StaffSpouse?
  children                 StaffChild[]
  timetables               Timetable[]
  studentAttendancesMarked StudentAttendance[]
  staffAttendances         StaffAttendance[]
  feeCollections           FeeCollection[]
  examMarksEntered         ExamMark[]
  user                     User?
  resultPublications       ResultPublication[]

  @@unique([employeeId, tenantId])
  @@unique([email, tenantId])
  @@index([tenantId])
}

model StaffSubject {
  id        Int      @id @default(autoincrement())
  staffId   Int
  subjectId Int
  tenantId  Int
  createdAt DateTime @default(now())
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([staffId, subjectId])
  @@index([tenantId])
}

model StaffAddress {
  id                   Int      @id @default(autoincrement())
  staffId              Int      @unique
  tenantId             Int
  presentAddress       String?
  presentCity          String?
  presentState         String?
  presentCountry       String?
  presentPinCode       String?
  presentTelephoneNo   String?
  permanentAddress     String?
  permanentCity        String?
  permanentState       String?
  permanentCountry     String?
  permanentPinCode     String?
  permanentTelephoneNo String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  staff                Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model StaffOtherDetails {
  id                  Int       @id @default(autoincrement())
  staffId             Int       @unique
  tenantId            Int
  dateOfAppointment   DateTime?
  probationUpto       DateTime?
  dateOfConfirmation  DateTime?
  designation         String?
  fromDate            DateTime?
  natureOfAppointment String?
  passportNo          String?
  passportIssuePlace  String?
  passportIssueDate   DateTime?
  passportExpireDate  DateTime?
  visaNo              String?
  visaIssuePlace      String?
  visaIssueDate       DateTime?
  visaExpiryDate      DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  staff               Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model StaffSpouse {
  id              Int       @id @default(autoincrement())
  staffId         Int       @unique
  tenantId        Int
  name            String?
  dateOfBirth     DateTime?
  mobileNo        String?
  marriageDate    DateTime?
  qualification   String?
  employerDetails String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  staff           Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model StaffChild {
  id          Int       @id @default(autoincrement())
  staffId     Int
  tenantId    Int
  name        String?
  dateOfBirth DateTime?
  gender      Gender?
  schoolName  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  staff       Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@index([tenantId])
}

// ─────────────────────────────────────────────
// STUDENT
// ─────────────────────────────────────────────
model Student {
  id                  Int                 @id @default(autoincrement())
  admissionNo         String
  feeNo               String?
  siblingAdmNo        String?
  studentName         String
  childLivingWith     String?
  photoUrl            String?
  signatureUrl        String?
  fatherTitle         String?
  fatherName          String?
  motherTitle         String?
  motherName          String?
  classId             Int
  sectionId           Int?
  stream              String?
  feeGroup            String?
  feePaymentStartFrom String?
  dateOfBirth         DateTime?
  dateOfAdmission     DateTime?
  dateOfJoin          DateTime?
  rollNo              String?
  gender              Gender?
  admissionType       AdmissionType       @default(new)
  classAdmitted       String?
  emergencyPhoneNo    String?
  house               String?
  boardingCategory    String?
  board               String?
  medium              String?
  boardRegistrationNo String?
  studentEmail        String?
  countryCode         String?
  communicationMobile String?
  communicationEmail  String?
  aadharNo            String?
  remark              String?
  feeRemark           String?
  uniqueNo            String?
  grNo                String?
  rfidNo              String?
  eNach               String?
  bankName            String?
  accountNo           String?
  ifsc                String?
  virtualAccountNo    String?
  apaarId             String?
  srnNo               String?
  bloodGroup          String?
  religion            String?
  category            String?
  motherTongue        String?
  nationality         String?
  maritalStatus       String?
  tenantId            Int
  isDeleted           Boolean             @default(false)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  class               Class               @relation(fields: [classId], references: [id])
  section             Section?            @relation(fields: [sectionId], references: [id])
  parents             StudentParent[]
  customFieldValues   CustomFieldValue[]
  studentAttendances  StudentAttendance[]
  feeCollections      FeeCollection[]
  examMarks           ExamMark[]

  @@unique([admissionNo, tenantId])
  @@index([tenantId])
}

model StudentParent {
  id                  Int      @id @default(autoincrement())
  studentId           Int
  tenantId            Int
  relation            String
  title               String?
  name                String
  photoUrl            String?
  signatureUrl        String?
  qualification       String?
  occupation          String?
  designation         String?
  organizationName    String?
  organizationAddress String?
  email               String?
  aadharNo            String?
  mobile              String?
  telephoneNo         String?
  nationality         String?
  annualIncome        Decimal? @db.Decimal(12, 2)
  annualIncomeSlab    String?
  city                String?
  state               String?
  country             String?
  pinCode             String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  student             Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  user                User?

  @@index([studentId])
  @@index([tenantId])
}

// ─────────────────────────────────────────────
// MASTER DATA
// ─────────────────────────────────────────────
model MasterData {
  id        Int      @id @default(autoincrement())
  category  String
  value     String
  isActive  Boolean  @default(true)
  tenantId  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([category, value, tenantId])
  @@index([tenantId, category])
}

// ─────────────────────────────────────────────
// CUSTOM FIELDS
// ─────────────────────────────────────────────
model CustomField {
  id          Int                @id @default(autoincrement())
  formName    String
  name        String
  displayName String
  control     String
  dataType    String             @default("text")
  priority    Int                @default(1)
  maxLength   Int?
  isActive    Boolean            @default(true)
  tenantId    Int
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  values      CustomFieldValue[]
  options     CustomFieldOption[]

  @@unique([formName, name, tenantId])
  @@index([tenantId])
}

model CustomFieldValue {
  id            Int         @id @default(autoincrement())
  customFieldId Int
  studentId     Int
  value         String
  tenantId      Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  customField   CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)
  student       Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([customFieldId, studentId])
  @@index([tenantId])
}

model CustomFieldOption {
  id            Int         @id @default(autoincrement())
  customFieldId Int
  label         String
  value         String
  priority      Int         @default(1)
  isActive      Boolean     @default(true)
  tenantId      Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  customField   CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([customFieldId])
}

// ─────────────────────────────────────────────
// TIMETABLE
// ─────────────────────────────────────────────
model PeriodSlot {
  id         Int         @id @default(autoincrement())
  tenantId   Int
  slotNo     Int
  label      String
  slotType   String // "period" | "recess" | "lunch" | "sports"
  startTime  String // "08:00"
  endTime    String // "08:45"
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  timetables Timetable[]

  @@unique([tenantId, slotNo])
  @@index([tenantId])
}

model Timetable {
  id             Int          @id @default(autoincrement())
  tenantId       Int
  academicYearId Int
  classId        Int
  sectionId      Int?
  subjectId      Int
  staffId        Int
  periodSlotId   Int
  dayOfWeek      Int // 1=Mon 2=Tue 3=Wed 4=Thu 5=Fri 6=Sat
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  class          Class        @relation(fields: [classId], references: [id])
  section        Section?     @relation(fields: [sectionId], references: [id])
  subject        Subject      @relation(fields: [subjectId], references: [id])
  staff          Staff        @relation(fields: [staffId], references: [id])
  periodSlot     PeriodSlot   @relation(fields: [periodSlotId], references: [id])

  @@unique([tenantId, academicYearId, staffId, dayOfWeek, periodSlotId])
  @@unique([tenantId, academicYearId, classId, sectionId, dayOfWeek, periodSlotId])
  @@index([tenantId])
}

// ─────────────────────────────────────────────
// ATTENDANCE
// ─────────────────────────────────────────────
model StudentAttendance {
  id             Int              @id @default(autoincrement())
  tenantId       Int
  academicYearId Int
  studentId      Int
  classId        Int
  sectionId      Int?
  date           DateTime         @db.Date
  status         AttendanceStatus @default(present)
  remark         String?
  markedById     Int
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id])
  student        Student          @relation(fields: [studentId], references: [id])
  class          Class            @relation(fields: [classId], references: [id])
  section        Section?         @relation(fields: [sectionId], references: [id])
  markedBy       Staff            @relation(fields: [markedById], references: [id])

  @@unique([tenantId, studentId, date])
  @@index([tenantId, classId, date])
  @@index([tenantId, studentId])
}

model StaffAttendance {
  id             Int              @id @default(autoincrement())
  tenantId       Int
  academicYearId Int
  staffId        Int
  date           DateTime         @db.Date
  status         AttendanceStatus @default(present)
  inTime         String?
  outTime        String?
  remark         String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id])
  staff          Staff            @relation(fields: [staffId], references: [id])

  @@unique([tenantId, staffId, date])
  @@index([tenantId, staffId])
  @@index([tenantId, date])
}

// ─────────────────────────────────────────────
// FEE MANAGEMENT
// ─────────────────────────────────────────────
model FeeCategory {
  id            Int            @id @default(autoincrement())
  tenantId      Int
  name          String
  description   String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feeStructures FeeStructure[]

  @@unique([name, tenantId])
  @@index([tenantId])
}

model FeeStructure {
  id              Int             @id @default(autoincrement())
  tenantId        Int
  academicYearId  Int
  classId         Int
  feeCategoryId   Int
  stream          String?
  studentCategory String?
  amount          Decimal         @db.Decimal(10, 2)
  frequency       String          @default("annual")
  dueDay          Int?
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear    AcademicYear    @relation(fields: [academicYearId], references: [id])
  class           Class           @relation(fields: [classId], references: [id])
  feeCategory     FeeCategory     @relation(fields: [feeCategoryId], references: [id])
  collections     FeeCollection[]

  @@index([tenantId, academicYearId, classId])
}

model FeeCollection {
  id             Int          @id @default(autoincrement())
  tenantId       Int
  receiptNo      String
  studentId      Int
  feeStructureId Int
  academicYearId Int
  amount         Decimal      @db.Decimal(10, 2)
  discount       Decimal      @default(0) @db.Decimal(10, 2)
  fine           Decimal      @default(0) @db.Decimal(10, 2)
  netAmount      Decimal      @db.Decimal(10, 2)
  paymentMode    String
  paymentDate    DateTime     @db.Date
  chequeNo       String?
  bankName       String?
  transactionId  String?
  remark         String?
  collectedById  Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student        Student      @relation(fields: [studentId], references: [id])
  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id])
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  collectedBy    Staff        @relation(fields: [collectedById], references: [id])

  @@unique([receiptNo, tenantId])
  @@index([tenantId, studentId])
  @@index([tenantId, academicYearId])
}

// ─────────────────────────────────────────────
// EXAM & MARKS (CBSE)
// ─────────────────────────────────────────────
model Exam {
  id                 Int                 @id @default(autoincrement())
  tenantId           Int
  academicYearId     Int
  name               String
  examType           ExamType
  classId            Int
  startDate          DateTime            @db.Date
  endDate            DateTime            @db.Date
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear       AcademicYear        @relation(fields: [academicYearId], references: [id])
  class              Class               @relation(fields: [classId], references: [id])
  resultPublications ResultPublication[]
  marks              ExamMark[]

  @@index([tenantId, academicYearId])
}

model ExamMark {
  id            Int      @id @default(autoincrement())
  tenantId      Int
  examId        Int
  studentId     Int
  subjectId     Int
  maxMarks      Decimal  @db.Decimal(6, 2)
  marksObtained Decimal? @db.Decimal(6, 2)
  isAbsent      Boolean  @default(false)
  grade         String?
  gradePoint    Decimal? @db.Decimal(4, 2)
  remark        String?
  enteredById   Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  exam          Exam     @relation(fields: [examId], references: [id])
  student       Student  @relation(fields: [studentId], references: [id])
  subject       Subject  @relation(fields: [subjectId], references: [id])
  enteredBy     Staff    @relation(fields: [enteredById], references: [id])

  @@unique([examId, studentId, subjectId])
  @@index([tenantId, examId])
  @@index([tenantId, studentId])
}

// ─────────────────────────────────────────────
// HOLIDAY CALENDAR
// ─────────────────────────────────────────────
model Holiday {
  id             Int          @id @default(autoincrement())
  tenantId       Int
  academicYearId Int
  name           String
  date           DateTime     @db.Date
  holidayType    String       @default("public") // "public" | "school" | "regional"
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  @@unique([tenantId, date])
  @@index([tenantId, academicYearId])
}

// ─────────────────────────────────────────────
// HOMEWORK / ASSIGNMENTS (recovered from live DB)
// ─────────────────────────────────────────────
model Assignment {
  id                   Int                    @id @default(autoincrement())
  tenantId             Int
  title                String
  description          String?
  classId              Int
  sectionId            Int?
  subjectId            Int
  teacherId            Int
  dueDate              DateTime
  attachmentUrl        String?
  maxMarks             Int?                   @default(100)
  isActive             Boolean                @default(true)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime
  AssignmentSubmission AssignmentSubmission[]

  @@index([tenantId, classId, sectionId, subjectId])
  @@index([tenantId, teacherId])
}

model AssignmentSubmission {
  id            Int                      @id @default(autoincrement())
  tenantId      Int
  assignmentId  Int
  studentId     Int
  content       String?
  attachmentUrl String?
  status        HomeworkSubmissionStatus @default(submitted)
  submittedAt   DateTime                 @default(now())
  grade         Int?
  feedback      String?
  gradedById    Int?
  gradedAt      DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime
  Assignment    Assignment               @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, assignmentId, studentId])
  @@index([tenantId, studentId])
}

// ─────────────────────────────────────────────
// NOTIFICATIONS (recovered from live DB)
// ─────────────────────────────────────────────
model Notification {
  id               Int                  @id @default(autoincrement())
  tenantId         Int
  title            String
  message          String
  type             String               @default("general")
  priority         NotificationPriority @default(normal)
  audience         NotificationAudience
  classId          Int?
  sectionId        Int?
  userId           Int?
  createdById      Int?
  isActive         Boolean              @default(true)
  expiresAt        DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime
  Tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  NotificationRead NotificationRead[]

  @@index([tenantId, audience, isActive])
  @@index([tenantId, classId])
  @@index([tenantId, createdAt])
  @@index([tenantId, userId])
}

model NotificationRead {
  id             Int          @id @default(autoincrement())
  tenantId       Int
  notificationId Int
  userId         Int
  readAt         DateTime     @default(now())
  Notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  Tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([tenantId, userId])
}

// ─────────────────────────────────────────────
// RESULT PUBLICATION (recovered from live DB)
// ─────────────────────────────────────────────
model ResultPublication {
  id             Int          @id @default(autoincrement())
  tenantId       Int
  academicYearId Int
  classId        Int
  examId         Int?
  isPublished    Boolean      @default(false)
  publishedById  Int?
  publishedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  AcademicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  Class          Class        @relation(fields: [classId], references: [id])
  Exam           Exam?        @relation(fields: [examId], references: [id])
  Staff          Staff?       @relation(fields: [publishedById], references: [id])
  Tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([academicYearId, classId, examId])
  @@index([tenantId, academicYearId])
}

enum HomeworkSubmissionStatus {
  pending
  submitted
  late
  graded
}

enum NotificationAudience {
  all
  admin
  staff
  teacher
  student
  parent
  class
  individual
}

enum NotificationPriority {
  low
  normal
  high
  urgent
}
